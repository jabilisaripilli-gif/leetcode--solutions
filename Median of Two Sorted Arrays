class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        l=nums1+nums2
        l.sort()
        if len(l)%2==0:
            med=(l[len(l)//2-1]+l[len(l)//2])/2
        else:
            med=l[len(l)//2]  
        return med      

                
        
