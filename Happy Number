class Solution:
    def isHappy(self, n: int) -> bool:
        x=list(str(n))
        seen=list()
        while(n!=1):
            if n in seen:
                return False
            seen.append(n)
            sum=0
            for i in range(len(x)):
                sum+=int(x[i])**2 
            n=sum
            x=list(str(n))
        return True  
                       

     
        
