class Solution:
    def canConstruct(self, ransomNote: str, magazine: str) -> bool:
        freq={}
        for i in ransomNote:
            if i in freq:
                freq[i]+=1
            else:
                freq[i]=1    
        for j in magazine:
            if j in freq:
                freq[j]-=1     
        for i in range(len(ransomNote)):
            if freq[ransomNote[i]]>0:
                return False
        return True              
