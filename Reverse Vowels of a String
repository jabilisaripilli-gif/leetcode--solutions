class Solution:
    def reverseVowels(self, s: str) -> str:
        s=list(s)
        left=0
        right=len(s)-1
        while(left<right):
            if s[left] in "aeiouAEIOU":
                if s[right] in"aeiouAEIOU":
                     s[left],s[right]=s[right],s[left]
                     left+=1
                     right-=1
                else:
                    right-=1
            else:
                left+=1                        
        return ''.join(s)                       

        
