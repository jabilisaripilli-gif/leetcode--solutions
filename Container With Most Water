class Solution:
    def maxArea(self, height: List[int]) -> int:
        n=len(height)
        left=0
        right=n-1
        q=[]
        while(left<=right):
            length=min(height[left],height[right])
            width=right-left
            area=length*width
            q.append(area)
            if height[left]<height[right]:
                left+=1
            else:
                right-=1
        return max(q)    

