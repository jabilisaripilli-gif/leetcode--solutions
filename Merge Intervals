class Solution:
    def merge(self, intervals: list[list[int]]) -> list[list[int]]:
        intervals.sort()
        result=[]
        for i in range(len(intervals)):
            if len(result)==0 or intervals[i][0]>result[-1][1]:
                result.append(intervals[i])
            else:
                result[-1][1]=max(intervals[i][1],result[-1][1])
        return result        
                
        
        
