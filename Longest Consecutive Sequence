class Solution:
    def longestConsecutive(self, nums: list[int]) -> int:
        nums=set(nums)
        nums=sorted(nums)
        count=1
        ans=1
        if len(nums)==0:
            return 0
        for i in range(1,len(nums)):
            if (nums[i])==(nums[i-1])+1:
                count+=1
            else:
                count=1 
            ans=max(ans,count)           
        return ans       

               

        
